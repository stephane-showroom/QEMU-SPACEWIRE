@@ -432,6 +438,18 @@ static void leon3_generic_hw_init(MachineState *machine)
     grlib_apb_pnp_add_entry(apb_pnp, LEON3_UART_OFFSET, 0xFFF,
                             GRLIB_VENDOR_GAISLER, GRLIB_APBUART_DEV, 1,
                             LEON3_UART_IRQ, GRLIB_APBIO_AREA);
+
+    /* Allocate SpaceWire (GRSPW) cores */
+    dev = qdev_new(TYPE_GRLIB_APB_GRSPW);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, LEON3_GRSPW_OFFSET);
+    for (i = 0; i < LEON3_GRSPW_COUNT; i++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), i,
+                           qdev_get_gpio_in(irqmpdev, LEON3_GRSPW_IRQ + i));
+        grlib_apb_pnp_add_entry(apb_pnp, LEON3_GRSPW_OFFSET + 0x100 * i,
+                                0xFFF, GRLIB_VENDOR_GAISLER, GRLIB_GRSPW_DEV,
+                                0, LEON3_GRSPW_IRQ + i, GRLIB_APBIO_AREA);
+    }
 }
 
