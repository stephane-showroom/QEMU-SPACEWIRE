@@ -66,6 +66,12 @@
 #define LEON3_TIMER_IRQ    (6)
 #define LEON3_TIMER_COUNT  (2)
 
+#define LEON3_GRSPW_OFFSET (0x80000A00)  /* 4 cores, 0x100 apart */
+#define LEON3_GRSPW_IRQ    (10)          /* IRQ 10..13, one per core */
+#define LEON3_GRSPW_COUNT  (4)
+#define TYPE_GRLIB_APB_GRSPW "grlib-grspw"
+#define GRLIB_GRSPW_DEV    (0x1F)
+
 #define LEON3_APB_PNP_OFFSET (0x800FF000)
